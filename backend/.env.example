# Copy to .env and adjust. Existing environment variables take precedence.
PORT=8080

# PostgreSQL connection string.
DATABASE_URL=postgres://roomflow:roomflow@localhost:5432/roomflow?sslmode=disable

# Required by cmd/server. Use a long random value outside development.
JWT_SECRET=change-me-to-a-long-random-string

# JWT lifetime in seconds (default 7200 = 2 hours).
JWT_EXPIRES_IN=7200

# Allowed browser origin for CORS, or * during development.
CORS_ALLOWED_ORIGIN=*
